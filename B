local FlipCooldown = false
local frontFlipGui = nil

local function FortniteFlips()
    if FlipCooldown then
        return
    end

    FlipCooldown = true

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    local animate = character and character:FindFirstChild("Animate")

    if not hrp or not humanoid then
        FlipCooldown = false
        return
    end

    local savedTracks = {}

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            savedTracks[#savedTracks + 1] = {
                track = track,
                time = track.TimePosition,
                speed = track.Speed,
                weight = track.WeightCurrent
            }

            track:Stop(0)
        end
    end

    local animateWasEnabled = animate and animate.Enabled

    if animate then
        animate.Enabled = false
    end

    local oldAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    local duration = 0.45
    local steps = 120

    local startCFrame = hrp.CFrame
    local forwardVector = startCFrame.LookVector
    local upVector = Vector3.new(0, 1, 0)

    task.spawn(function()
        local startTime = tick()

        for i = 1, steps do
            if not character.Parent or humanoid.Health <= 0 then
                break
            end

            local t = i / steps
            local height = 4 * (t - t ^ 2) * 10

            local nextPos =
                startCFrame.Position
                + forwardVector * (35 * t)
                + upVector * height

            local rotation =
                startCFrame.Rotation
                * CFrame.Angles(
                    -math.rad(i * (360 / steps)),
                    0,
                    0
                )

            hrp.CFrame = CFrame.new(nextPos) * rotation

            local elapsedTime = tick() - startTime
            local expectedTime = (duration / steps) * i
            local waitTime = expectedTime - elapsedTime

            if waitTime > 0 then
                task.wait(waitTime)
            end
        end

        if character.Parent and humanoid.Health > 0 then
            hrp.CFrame =
                CFrame.new(startCFrame.Position + forwardVector * 35)
                * startCFrame.Rotation

            humanoid.AutoRotate = oldAutoRotate

            if animate then
                animate.Enabled = animateWasEnabled ~= false
            end

            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

            task.wait(0.05)

            humanoid:ChangeState(Enum.HumanoidStateType.Running)

            task.wait(0.1)

            if animator then
                for _, data in ipairs(savedTracks) do
                    if data.track and data.track.Parent then
                        pcall(function()
                            data.track:Play(
                                0.1,
                                data.weight,
                                data.speed
                            )

                            data.track.TimePosition = data.time
                        end)
                    end
                end
            end
        end

        task.wait(0.25)
        FlipCooldown = false
    end)
end

