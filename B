local espEnabled = false
local showNames = false
local showTracers = false
local showTeamMarkers = false

local highlightList = {}
local nameTexts = {}
local tracerLines = {}
local markerTexts = {}
local connections = {}

local function getPlayerColor(targetPlayer)
    local teamName = targetPlayer.TeamColor.Name
    if teamName == "Bright orange" or teamName == "Really orange" then
        return Color3.fromRGB(255, 165, 0)
    elseif teamName == "Really red" then
        return Color3.fromRGB(255, 0, 0)
    elseif teamName == "Really blue" or teamName == "Bright blue" then
        return Color3.fromRGB(0, 100, 255)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function applyHighlight(targetPlayer)
    if targetPlayer == player then return end
    local targetCharacter = targetPlayer.Character
    if not targetCharacter then return end
    if highlightList[targetPlayer] then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = getPlayerColor(targetPlayer)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    highlight.Parent = targetCharacter
    highlightList[targetPlayer] = highlight
end

local function removeHighlight(targetPlayer)
    local highlight = highlightList[targetPlayer]
    if highlight then
        highlight:Destroy()
        highlightList[targetPlayer] = nil
    end
end

local function clearAllHighlights()
    for targetPlayer, highlight in pairs(highlightList) do
        highlight:Destroy()
    end
    highlightList = {}
end

local function createNameText(targetPlayer)
    if nameTexts[targetPlayer] then return end
    local text = Drawing.new("Text")
    text.Text = targetPlayer.Name
    text.Size = 14
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Color = getPlayerColor(targetPlayer)
    text.Visible = false
    nameTexts[targetPlayer] = text
end

local function removeNameText(targetPlayer)
    local text = nameTexts[targetPlayer]
    if text then
        text:Destroy()
        nameTexts[targetPlayer] = nil
    end
end

local function createTracer(targetPlayer)
    if tracerLines[targetPlayer] then return end
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = getPlayerColor(targetPlayer)
    line.Transparency = 0.7
    line.Visible = false
    tracerLines[targetPlayer] = line
end

local function removeTracer(targetPlayer)
    local line = tracerLines[targetPlayer]
    if line then
        line:Destroy()
        tracerLines[targetPlayer] = nil
    end
end

local function createMarkerText(targetPlayer)
    if markerTexts[targetPlayer] then return end
    local marker = Drawing.new("Text")
    marker.Size = 18
    marker.Center = true
    marker.Outline = true
    marker.OutlineColor = Color3.fromRGB(0, 0, 0)
    marker.Visible = false
    markerTexts[targetPlayer] = marker
end

local function removeMarkerText(targetPlayer)
    local marker = markerTexts[targetPlayer]
    if marker then
        marker:Destroy()
        markerTexts[targetPlayer] = nil
    end
end

local function clearAllDrawings()
    for targetPlayer in pairs(nameTexts) do
        removeNameText(targetPlayer)
    end
    for targetPlayer in pairs(tracerLines) do
        removeTracer(targetPlayer)
    end
    for targetPlayer in pairs(markerTexts) do
        removeMarkerText(targetPlayer)
    end
end

local function disconnectAll()
    for _, conn in pairs(connections) do
        conn:Disconnect()
    end
    connections = {}
end

local function updateESP()
    local viewport = Camera.ViewportSize
    local centerBottom = Vector2.new(viewport.X / 2, viewport.Y)
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer == player then continue end
        local targetCharacter = targetPlayer.Character
        if not targetCharacter then
            if highlightList[targetPlayer] then removeHighlight(targetPlayer) end
            if nameTexts[targetPlayer] then removeNameText(targetPlayer) end
            if tracerLines[targetPlayer] then removeTracer(targetPlayer) end
            if markerTexts[targetPlayer] then removeMarkerText(targetPlayer) end
            continue
        end
        local head = targetCharacter:FindFirstChild("Head")
        if not head then
            if highlightList[targetPlayer] then removeHighlight(targetPlayer) end
            if nameTexts[targetPlayer] then removeNameText(targetPlayer) end
            if tracerLines[targetPlayer] then removeTracer(targetPlayer) end
            if markerTexts[targetPlayer] then removeMarkerText(targetPlayer) end
            continue
        end
        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            if highlightList[targetPlayer] then removeHighlight(targetPlayer) end
            if nameTexts[targetPlayer] then removeNameText(targetPlayer) end
            if tracerLines[targetPlayer] then removeTracer(targetPlayer) end
            if markerTexts[targetPlayer] then removeMarkerText(targetPlayer) end
            continue
        end
        if espEnabled then
            local color = getPlayerColor(targetPlayer)
            local highlight = highlightList[targetPlayer]
            if not highlight then
                applyHighlight(targetPlayer)
            else
                highlight.FillColor = color
            end
            if showNames then
                local text = nameTexts[targetPlayer]
                if not text then
                    createNameText(targetPlayer)
                    text = nameTexts[targetPlayer]
                end
                text.Position = Vector2.new(pos.X, pos.Y - 30)
                text.Color = color
                text.Visible = true
            else
                if nameTexts[targetPlayer] then
                    nameTexts[targetPlayer].Visible = false
                end
            end
            if showTracers then
                local line = tracerLines[targetPlayer]
                if not line then
                    createTracer(targetPlayer)
                    line = tracerLines[targetPlayer]
                end
                line.From = centerBottom
                line.To = Vector2.new(pos.X, pos.Y)
                line.Color = color
                line.Visible = true
            else
                if tracerLines[targetPlayer] then
                    tracerLines[targetPlayer].Visible = false
                end
            end
            if showTeamMarkers then
                local marker = markerTexts[targetPlayer]
                if not marker then
                    createMarkerText(targetPlayer)
                    marker = markerTexts[targetPlayer]
                end
                marker.Position = Vector2.new(pos.X, pos.Y - 45)
                marker.Text = "■"
                if targetPlayer.Team == player.Team then
                    marker.Color = Color3.fromRGB(0, 255, 0)
                else
                    marker.Color = Color3.fromRGB(255, 0, 0)
                end
                marker.Visible = true
            else
                if markerTexts[targetPlayer] then
                    markerTexts[targetPlayer].Visible = false
                end
            end
        end
    end
end

local function setupESP()
    clearAllHighlights()
    clearAllDrawings()
    disconnectAll()
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        applyHighlight(targetPlayer)
        createNameText(targetPlayer)
        createTracer(targetPlayer)
        createMarkerText(targetPlayer)
    end
    local function onPlayerAdded(targetPlayer)
        applyHighlight(targetPlayer)
        createNameText(targetPlayer)
        createTracer(targetPlayer)
        createMarkerText(targetPlayer)
        local charConn
        charConn = targetPlayer.CharacterAdded:Connect(function()
            applyHighlight(targetPlayer)
        end)
        connections[targetPlayer] = charConn
    end
    local function onPlayerRemoving(targetPlayer)
        removeHighlight(targetPlayer)
        removeNameText(targetPlayer)
        removeTracer(targetPlayer)
        removeMarkerText(targetPlayer)
        if connections[targetPlayer] then
            connections[targetPlayer]:Disconnect()
            connections[targetPlayer] = nil
        end
    end
    connections.PlayerAdded = Players.PlayerAdded:Connect(onPlayerAdded)
    connections.PlayerRemoving = Players.PlayerRemoving:Connect(onPlayerRemoving)
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if not connections[targetPlayer] then
            local charConn
            charConn = targetPlayer.CharacterAdded:Connect(function()
                applyHighlight(targetPlayer)
            end)
            connections[targetPlayer] = charConn
        end
    end
    RunService:BindToRenderStep("ESPRender", Enum.RenderPriority.Camera.Value, updateESP)
end

local function disableESP()
    clearAllHighlights()
    clearAllDrawings()
    disconnectAll()
    RunService:UnbindFromRenderStep("ESPRender")
end

