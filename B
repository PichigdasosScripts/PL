local speedMultiplier = 4
local speedEnabled = false
local BASE_SPEED = 16
local speedConnection

local function enableSpeed()
    if speedConnection then speedConnection:Disconnect() end
    speedConnection = RunService.RenderStepped:Connect(function(dt)
        if not speedEnabled then return end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if char and hrp and hrp.Parent then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                local CF_SPEED = BASE_SPEED * speedMultiplier
                hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * CF_SPEED * dt)
            end
        end
    end)
end

player.CharacterAdded:Connect(function(char)
    character = char
    root = char:WaitForChild("HumanoidRootPart")
    if speedEnabled then
        enableSpeed()
    end
end)

