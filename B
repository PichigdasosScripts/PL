local botActive = false
local botConnections = {}
local botThreads = {}

local function toggleBot(value)
    if value then
        if botActive then return end
        botActive = true

        local subjects = {
            "I", "You", "We", "They", "My friends",
            "My team", "The players", "The community", "My group", "The noobs",
            "The veterans", "Some players", "All of us", "Many people", "Both of us"
        }
        local verbs = {
            "want", "enjoy", "love", "prefer", "need",
            "play", "explore", "jump into", "run through", "win", "lose", "build",
            "fight for", "collect", "walk through", "fly over", "dance with", "sing about", "help",
            "compete for", "team up with", "survive", "have fun with", "chase"
        }
        local objects = {
            "Roblox", "the games", "the fun", "the adventure", "the missions",
            "the map", "the team", "the base", "the coins", "the loot",
            "the pets", "the friends", "the lobby", "the world", "the players",
            "the victory", "the vehicles", "the tools", "the skins",
            "the hats", "the swords", "the battle", "the treasure"
        }
        local complements = {
            "with my friends", "as a team", "together", "quickly", "right now",
            "later", "in the lobby", "in the game", "very well", "like a pro",
            "for real", "over here", "over there", "alone", "calmly", "excitedly",
            "nonstop", "at full speed", "with joy", "without fear"
        }
        local setPhrases = {
            "Hello everyone!", "How are you all?", "Let's play!", "This is so fun",
            "This is amazing", "Let's explore the map", "I won the match", "I lost this time",
            "Good game friends", "Team, stick together!", "I love Roblox",
            "Jump with me", "Run fast", "Let's go for the win!",
            "Let's build something epic", "The map is huge", "Friends are the best",
            "Let's have fun", "Anyone want to play?", "This is getting exciting",
            "I love this game", "Let's all go together", "This is epic"
        }
        local deathPhrases = {
            "That hurt!",
            "Not next time!",
            "So sad...!",
            "I'll try again!",
            "Death will not end my endless adventure!"
        }

        local function generatePhrase()
            local s = subjects[math.random(#subjects)]
            local v = verbs[math.random(#verbs)]
            local o = objects[math.random(#objects)]
            if math.random() < 0.6 then
                local c = complements[math.random(#complements)]
                return s .. " " .. v .. " " .. o .. " " .. c
            else
                return s .. " " .. v .. " " .. o
            end
        end

        local function getPhrase()
            if math.random() < 0.25 then
                return setPhrases[math.random(#setPhrases)]
            else
                return generatePhrase()
            end
        end

        local replicatedStorage = game:GetService("ReplicatedStorage")
        local chatEvent = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvent then chatEvent = chatEvent:FindFirstChild("SayMessageRequest") end
        local chatService = game:GetService("Chat")

        local function speak(message)
            if chatEvent then
                chatEvent:FireServer(message, "All")
            else
                local character = player.Character
                if character then
                    local head = character:FindFirstChild("Head")
                    if head then
                        chatService:Chat(head, message)
                    end
                end
            end
        end

        local function getRandomPosition(rootPart)
            local center = rootPart and rootPart.Position or Vector3.new(0, 0, 0)
            local radius = 45
            local angle = math.random() * 2 * math.pi
            local distance = 15 + math.random() * (radius - 15)
            local x = center.X + math.cos(angle) * distance
            local z = center.Z + math.sin(angle) * distance
            local y = rootPart and rootPart.Position.Y or 0
            return Vector3.new(x, y, z)
        end

        local alreadySaidDeath = false
        local currentDestination = nil
        local jumpTimer = 0
        local JUMP_INTERVAL = 4.5

        local function getCharacter()
            local char = player.Character or player.CharacterAdded:Wait()
            local hum = char:FindFirstChildOfClass("Humanoid")
            return char, hum
        end

        local char, hum = getCharacter()

        local function onDied()
            if not botActive then return end
            if not alreadySaidDeath then
                alreadySaidDeath = true
                local phrase = deathPhrases[math.random(#deathPhrases)]
                speak(phrase)
            end
        end

        if hum then
            hum.Died:Connect(onDied)
        end

        local charAddedConn = player.CharacterAdded:Connect(function(newChar)
            char = newChar
            hum = char:WaitForChild("Humanoid")
            alreadySaidDeath = false
            currentDestination = nil
            hum.Died:Connect(onDied)
        end)
        table.insert(botConnections, charAddedConn)

        local function pickNewDestination()
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                currentDestination = getRandomPosition(rootPart)
                hum:MoveTo(currentDestination)
            end
        end

        local moveThread = task.spawn(function()
            while botActive do
                task.wait(0.3)
                if hum and hum.Health > 0 then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        if not currentDestination then
                            pickNewDestination()
                        else
                            local distance = (rootPart.Position - currentDestination).Magnitude
                            if distance < 4 then
                                pickNewDestination()
                            else
                                hum:MoveTo(currentDestination)
                            end
                        end
                    end
                    jumpTimer = jumpTimer + 0.3
                    if jumpTimer >= JUMP_INTERVAL then
                        if hum:GetState() == Enum.HumanoidStateType.Landed or hum:GetState() == Enum.HumanoidStateType.Running then
                            hum.Jump = true
                        end
                        jumpTimer = 0
                    end
                else
                    local newChar = player.Character
                    if newChar and newChar ~= char then
                        char = newChar
                        hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            alreadySaidDeath = false
                            currentDestination = nil
                            hum.Died:Connect(onDied)
                        end
                    end
                end
            end
        end)
        table.insert(botThreads, moveThread)

        local speakThread = task.spawn(function()
            while botActive do
                task.wait(10 + math.random(0, 3))
                if hum and hum.Health > 0 then
                    speak(getPhrase())
                end
            end
        end)
        table.insert(botThreads, speakThread)

    else
        botActive = false
        for _, conn in ipairs(botConnections) do
            conn:Disconnect()
        end
        botConnections = {}
        for _, h in ipairs(botThreads) do
            task.cancel(h)
        end
        botThreads = {}
    end
end

