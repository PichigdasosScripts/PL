local antiArrestEnabled = false
local antiTaseEnabled = false
local animConnection = nil

local ARREST_ANIMATION = "rbxassetid://287112271"
local TASE_ANIMATION = "rbxassetid://279227693"

local function setupProtectionConnection()
    if animConnection then animConnection:Disconnect() end

    local function onCharacterAdded(char)
        local humanoid = char:WaitForChild("Humanoid")
        local animator = humanoid:WaitForChild("Animator")

        animator.AnimationPlayed:Connect(function(des)
            if antiArrestEnabled and des.Animation.AnimationId == ARREST_ANIMATION then
                local Humanoid = player.Character:WaitForChild("Humanoid")
                Humanoid:ChangeState(Enum.HumanoidStateType.Dead)

                local cpos = char:WaitForChild("HumanoidRootPart").CFrame
                local wasCriminal = (player.TeamColor.Name == "Really red")

                player.CharacterAdded:Wait()
                repeat task.wait() until player.Character:FindFirstChild("HumanoidRootPart")
                task.wait(0.1)

                if wasCriminal then
                    pcall(function()
                        player.Character.HumanoidRootPart.CFrame = cpos
                    end)
                end
            end

            if antiTaseEnabled and des.Animation.AnimationId == TASE_ANIMATION then
                des:Stop()
                des:Destroy()
                player.Character.Humanoid.PlatformStand = false
                player.Character.Humanoid.Sit = false
                player.Character.Humanoid.WalkSpeed = 16
                player.Character.Humanoid.JumpPower = 50
            end
        end)
    end

    if player.Character then
        onCharacterAdded(player.Character)
    end

    animConnection = player.CharacterAdded:Connect(onCharacterAdded)
end

